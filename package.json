{
  "name": "sasapps",
  "description": "Experts in SAS Data Analytics and Management. Analyse Implement Maximise",
  "version": "4.0.0",
  "author": "",
  "main": "n/a",
  "scripts": {
    "start": "gatsby develop",
    "build": "gatsby build",
    "develop": "gatsby develop",
    "buildsync": "gatsby build && npm run sync",
    "lint": "eslint --fix --ext .ts,.tsx,.js,.jsx --ignore-pattern '/types/' --ignore-path .gitignore .",
    "lint:prettier": "prettier --check \"src/**/*.+(ts|tsx|js|jsx|json|css|scss)\"",
    "lint:prettierfix": "prettier --write \"src/**/*.+(ts|tsx|js|jsx|json|css|scss)\" --ignore-path .gitignore",
    "lint:text": "textlint content/posts/*.md",
    "lint:textfix": "textlint --fix content/posts/*.md"
  },
  "dependencies": {
    "gatsby": "^5.16.0",
    "gatsby-plugin-catch-links": "^5.16.0",
    "gatsby-plugin-feed": "^5.16.0",
    "gatsby-plugin-graphql-codegen": "^3.1.1",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-sass": "^6.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-remark-copy-linked-files": "^6.16.0",
    "gatsby-remark-embed-video": "^3.2.1",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-prismjs": "^7.16.0",
    "gatsby-remark-responsive-iframe": "^6.16.0",
    "gatsby-remark-smartypants": "^6.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "graphql": "^16.7.1",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-brands-svg-icons": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@types/react-helmet": "^6.0.30",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "animate.css": "^4.1.1",
    "babel-eslint": "^10.1.0",
    "bootstrap": "^4.6.2",
    "emergence.js": "^1.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "font-awesome": "^4.7.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.4",
    "jquery": "^3.7.1",
    "lint-staged": "^15.2.7",
    "modern-normalize": "^2.0.0",
    "popper.js": "^1.16.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "textlint": "^14.2.1",
    "textlint-rule-preset-ja-spacing": "^2.0.3",
    "textlint-rule-preset-japanese": "^10.0.4",
    "typescript": "^5.5.4"
  },
  "keywords": [
    "gatsby",
    "gatstrap",
    "starter"
  ],
  "license": "MIT",
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,json,css,scss,md}": [
      "prettier --write"
    ],
    "*.md": [
      "npm run lint:textfix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "overrides": {
    "graphql": "^16.7.1",
    "graphql-compose": "9.0.11"
  }
}
